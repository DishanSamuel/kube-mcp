# kube-log-mcp — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ──────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────

# Slack Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token with connections:write scope (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token

# Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────

# Path to the compiled Go MCP gateway binary
GATEWAY_BINARY_PATH=./bin/gateway

# Anthropic model to use
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Max tool-call rounds before the agent stops
# MAX_TOOL_ROUNDS=10

# JSON-RPC call timeout in seconds
# MCP_RPC_TIMEOUT=30

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Restrict auto-response to specific Slack channel IDs (comma-separated)
# INCIDENT_CHANNELS=C0123456789,C9876543210

# Prometheus URL (only relevant when running inside the cluster)
# PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090
